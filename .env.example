# Copy the values you need into `.env.local` for development, and into
# Vercel → Project → Settings → Environment Variables for deployments.
# After changing a variable on Vercel you must redeploy for it to take effect.

# ---------------------------------------------------------------------------
# Database (Supabase / PostgreSQL) — required
# ---------------------------------------------------------------------------
# Project → Connect → Connection pooling. Keep the pooler host
# (…pooler.supabase.com) — serverless functions cannot use the direct
# `db.<ref>.supabase.co` host, which is IPv6-only.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Admin auth (Better Auth) — required
# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION. Without it Better Auth refuses to start and every
# /admin route fails with "This page couldn't load".
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of the app. Local dev: http://localhost:3000.
# On Vercel: set it to the URL you actually visit (https://your-domain.com).
# Leaving it unset also works — the origin is then taken from the request.
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# First admin account — seeded automatically on boot
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@seamrahman.com
# Only applied the first time the account is created — changing it later has no
# effect. To change an existing password run:
#   npx tsx src/scripts/set-admin-password.ts
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Admin

# ---------------------------------------------------------------------------
# Cloudinary — optional, enables direct browser → Cloudinary uploads
# ---------------------------------------------------------------------------
# Without these the admin still works and falls back to storing uploads in the
# database as base64 (smaller images only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=seam-rahman
